# Copy file này thành .env khi cần chạy Requirement Refiner thật.
# Mặc định fake để smoke test không tốn token/API cost.
# Enum: fake | deepseek | openai_compatible.
# `fake` không gọi API; hai mode còn lại gọi Chat Completions tương thích OpenAI.
SDLC_LLM_MODE=fake

# API key của provider; bắt buộc khi SDLC_LLM_MODE khác fake.
SDLC_LLM_API_KEY=

# Base URL không gồm `/chat/completions` vì client tự nối suffix này.
SDLC_LLM_BASE_URL=https://api.deepseek.com

# Tên model được gửi trong payload Chat Completions.
SDLC_LLM_MODEL=deepseek-chat

# Timeout mỗi request LLM, tính bằng giây. Số nguyên >= 1; mặc định 90.
SDLC_LLM_TIMEOUT_SECONDS=90

# Giới hạn output cho các lời gọi Developer bắt buộc trả JSON.
# DeepSeek Chat hiện hỗ trợ tối đa 8192 output tokens; số nguyên >= 1024.
SDLC_LLM_STRUCTURED_MAX_TOKENS=8192

# Cửa sổ context của model đang chạy. Harness dùng giá trị này để chừa headroom
# cho input và tự hạ output budget của từng action khi cần.
SDLC_LLM_CONTEXT_WINDOW_TOKENS=128000

# Cơ chế sinh code Phase 4. `tool_loop` triển khai từng file qua action protocol
# và có journal để resume; `legacy` chỉ còn là rollback tạm thời có chủ đích.
SDLC_DEVELOPER_EXECUTION_MODE=tool_loop

# Giới hạn số action cho mỗi work item và số lần chấp nhận action lỗi/bị cắt.
SDLC_DEVELOPER_MAX_ACTIONS_PER_ITEM=24
SDLC_DEVELOPER_MAX_ACTION_RETRIES=2

# Số vòng Designer sửa design sau Validator; số nguyên >= 0, 0 là không repair.
SDLC_DESIGN_REPAIR_LIMIT=2

# Số lượt Semantic Design Validator chấm cùng một design; 1 giữ hành vi V2 cũ.
SDLC_DESIGN_VALIDATION_TRIALS=3
SDLC_DESIGN_LLM_CALL_BUDGET=16

# Số vòng Developer.plan sửa implementation plan sau rule + LLM review.
# Số nguyên >= 0, 0 là không repair.
SDLC_IMPLEMENTATION_PLAN_REPAIR_LIMIT=2

# Số vòng Developer -> Verification -> Validator repair tự động.
# Số nguyên >= 0, 0 là không repair.
SDLC_IMPLEMENTATION_REPAIR_LIMIT=2

# Code Validator chạy 2 semantic trial đầu và chỉ chạy trial thứ ba khi bất đồng.
# Call budget bao gồm retry output JSON/trial không hợp lệ trên cùng code snapshot.
SDLC_IMPLEMENTATION_VALIDATION_TRIALS=3
SDLC_IMPLEMENTATION_VALIDATION_CALL_BUDGET=6

# Số vòng Developer sửa code/test trong loop lớn sau khi QA fail.
# Số nguyên >= 0, 0 là không repair; mặc định 1.
SDLC_QA_REPAIR_LIMIT=1

# Atlassian config cho Jira source intake và Phase 1/2 real sync.
# Các biến ATLASSIAN_* dùng cho cả Jira source intake và real sync.
# Giữ SDLC_SYNC_MODE=mock cho test thường; đổi real khi muốn ghi checkpoint lên tool.
# Enum: mock | real | both.
# `mock` chỉ ghi report local; `real` ghi tool thật; `both` chạy cả hai.
# CLI có side effect vẫn mặc định `--sync-mode mock`, nên real phải được caller
# truyền rõ bằng CLI (Niko cũng truyền giá trị này khi tích hợp).
SDLC_SYNC_MODE=mock

# URL gốc Atlassian, ví dụ `https://example.atlassian.net`; không có slash cuối.
ATLASSIAN_BASE_URL=

# Email tài khoản đã tạo Atlassian API token.
ATLASSIAN_EMAIL=

# Atlassian API token; đây là secret, chỉ điền trong `.env` thật.
ATLASSIAN_API_TOKEN=

# Bật sync Jira. Truthy: 1 | true | yes | on; dùng 0 để tắt.
JIRA_SYNC_ENABLED=0

# Jira issue key nhận comment/checkpoint, ví dụ `SDLC-1`.
JIRA_SYNC_ISSUE_KEY=

# Bật sync Confluence. Truthy: 1 | true | yes | on; dùng 0 để tắt.
CONFLUENCE_SYNC_ENABLED=0

# ID của Confluence space đích, không phải space key hiển thị.
CONFLUENCE_SYNC_SPACE_ID=

# Page ID của trang cha chứa các page artifact do Harness tạo.
CONFLUENCE_SYNC_PARENT_PAGE_ID=

# Target repository và worktree-per-run.
# TypeScript full-stack là profile mặc định cho run mới. Để trống chỉ cho phép
# đọc/audit/sync và cleanup run legacy đã có; start mới trả
# `project_profile_required`.
SDLC_PROJECT_PROFILE=typescript_fullstack_v1

# Repo nhận code do Developer sinh. Đường dẫn tuyệt đối hoặc tương đối với root
# SDLC_Harness; mặc định là `../SDLC_Target_TypeScript`.
SDLC_TARGET_REPO_PATH=../SDLC_Target_TypeScript

# Root chứa Git worktree riêng cho từng run. Để trống sẽ dùng thư mục sibling
# `<target-repo-name>-worktrees`; config loader không tự tạo thư mục lúc đọc.
SDLC_TARGET_WORKTREE_ROOT=

# Git remote URL dùng để chuẩn bị/fetch target repo và xác minh workspace.
SDLC_TARGET_REPO_REMOTE=https://github.com/LuongAnh1/SDLC_Target_TypeScript.git

# Nhánh gốc để tạo branch riêng cho mỗi run.
SDLC_TARGET_BASE_BRANCH=main

# Prefix branch triển khai; Harness tự bỏ slash thừa và nối source/run suffix.
SDLC_IMPLEMENTATION_BRANCH_PREFIX=feature

# Verification Runner ưu tiên `javac` trên PATH, rồi SDLC_JAVA_HOME/JAVA_HOME từ
# OS environment, sau đó tự dò thư mục JDK phổ biến trên Windows. Hai biến Java
# hiện là OS-level fallback, không được đọc từ file `.env` này.

# API bootstrap. Mặc định chỉ bind loopback; khi bind ra địa chỉ khác,
# SDLC_API_TOKEN là bắt buộc và client gửi `Authorization: Bearer <token>`.
# SDLC_RUNTIME_CONFIG_FILE chỉ định file override do dashboard quản lý; đường dẫn
# tương đối được resolve từ root SDLC_Harness.
SDLC_RUNTIME_CONFIG_FILE=.runtime/config.json
SDLC_API_HOST=127.0.0.1
SDLC_API_PORT=7788
SDLC_API_TOKEN=

# Số operation tối đa đang chờ; Slice 3 dùng cố định một worker.
SDLC_API_QUEUE_LIMIT=32

# Thời gian tối đa chờ shutdown server hoàn tất, tính bằng giây.
SDLC_API_SHUTDOWN_TIMEOUT_SECONDS=30
